file(REMOVE_RECURSE
    "@SPREADSHEETENGINE_PACKAGE_TEST_PREFIX@"
    "@SPREADSHEETENGINE_PACKAGE_TEST_BUILD_DIR@"
)

execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@" --prefix "@SPREADSHEETENGINE_PACKAGE_TEST_PREFIX@"
    RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
    message(FATAL_ERROR "Failed to install spreadsheetengine package for consumer smoke test")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@"
        -S "@CMAKE_CURRENT_SOURCE_DIR@/tests/consumer"
        -B "@SPREADSHEETENGINE_PACKAGE_TEST_BUILD_DIR@"
        "-DCMAKE_PREFIX_PATH=@SPREADSHEETENGINE_PACKAGE_TEST_PREFIX@"
    RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
    message(FATAL_ERROR "Failed to configure installed-package consumer smoke test")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "@SPREADSHEETENGINE_PACKAGE_TEST_BUILD_DIR@"
    RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
    message(FATAL_ERROR "Failed to build installed-package consumer smoke test")
endif()

execute_process(
    COMMAND "@SPREADSHEETENGINE_PACKAGE_TEST_BUILD_DIR@/spreadsheetengine_consumer_smoke"
    RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
    message(FATAL_ERROR "Installed-package consumer smoke test executable failed")
endif()
